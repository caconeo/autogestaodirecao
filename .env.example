# Neon Postgres pooled connection string for Netlify Functions
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# JWT verification. Use a long random secret and the same issuer/audience as the identity provider.
AUTH_JWT_SECRET="replace-with-at-least-32-random-bytes"
AUTH_JWT_ISSUER="https://auth.example.com"
AUTH_JWT_AUDIENCE="auto-gestao-direcao"

# Optional CORS origin. Same-origin deployments can leave this unset.
ALLOWED_ORIGIN="https://autogestaodirecao.netlify.app"
# Independent HMAC secret for CPF lookup; never reuse AUTH_JWT_SECRET.
CPF_LOOKUP_SECRET="replace-with-another-independent-32-byte-secret"
